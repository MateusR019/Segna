# ============================================================
# SEGNA — Variáveis de ambiente necessárias
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local — ele já está no .gitignore.
# ============================================================

# ─── Supabase (obrigatório) ───────────────────────────────────
# Encontre em: dashboard.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# ─── Supabase CLI (necessário apenas para rodar scripts de DB) ─
# Access Token: dashboard.supabase.com/account/tokens → "New token"
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxx

# DB Password: dashboard.supabase.com/project/REF/settings/database
SUPABASE_DB_PASSWORD=sua_senha_do_banco

# Service Role Key: dashboard.supabase.com → Project Settings → API → service_role
# ATENÇÃO: nunca exponha esta chave no frontend. Só usada nos scripts locais.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui
